{
  // Cloudflare Workers static-assets deploy (what `npx wrangler deploy` uses). The SPA fallback serves
  // index.html for client-side routes such as /w/<slug>/agent. Classic Pages projects need no config.
  "name": "ai-ticketing-system",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
