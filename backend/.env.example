# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Infrastructure
DATABASE_URL=postgres://localhost:5432/bookleaf
REDIS_URL=redis://localhost:6379/0

# AI (server-side only; never exposed to the frontend)
# Works with any OpenAI-compatible provider. Leave AI_BASE_URL empty for OpenAI.
# Free option, Google Gemini (key from https://aistudio.google.com/apikey):
#   OPENAI_API_KEY=<gemini key>
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-3.8-flash
#   AI_REASONING_EFFORT=none
#   AI_PRICE_INPUT_PER_M=0
#   AI_PRICE_OUTPUT_PER_M=0
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_REASONING_EFFORT=
AI_TIMEOUT_SECONDS=20

# Attachments: leave empty to use local disk. Any S3-compatible store works.
# Supabase Storage example (Project Settings > Storage > S3 Connection):
#   AWS_STORAGE_BUCKET_NAME=attachments
#   AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_S3_REGION_NAME=<region shown in Supabase, e.g. ap-south-1>
#   AWS_S3_ADDRESSING_STYLE=path
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=auto
