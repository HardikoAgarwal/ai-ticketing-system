# --- Django ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production behind a platform proxy: set to false only if the platform already terminates TLS and redirects.
# SECURE_SSL_REDIRECT=true

# --- Database (local Postgres, or a Neon connection string in production) ---
DATABASE_URL=postgres://localhost:5432/helpdesk

# --- AI (server-side only; never exposed to the frontend) ---
# Any OpenAI-compatible provider. Free option: Google Gemini (key from https://aistudio.google.com/apikey)
#   OPENAI_API_KEY=<gemini key>
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-3.1-flash-lite
#   AI_REASONING_EFFORT=none
#   AI_PRICE_INPUT_PER_M=0
#   AI_PRICE_OUTPUT_PER_M=0
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_EMBED_MODEL=gemini-embedding-001
AI_EMBED_DIMENSIONS=768
AI_REASONING_EFFORT=
AI_TIMEOUT_SECONDS=20
# Free-tier protection: hard daily caps on live chat calls (embeddings are not counted)
AI_DAILY_CALL_CAP=400
AI_WORKSPACE_DAILY_CAP=40

# --- Demo sandbox ---
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=200
DEMO_START_THROTTLE=10/hour

# --- Inbound email webhook (POST /api/v1/inbound/email/); leave empty to disable ---
INBOUND_EMAIL_SECRET=

# --- Attachments: leave empty to use local disk. Any S3-compatible store works. ---
# Supabase Storage example (Project Settings > Storage > S3 Connection):
#   AWS_STORAGE_BUCKET_NAME=attachments
#   AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_S3_REGION_NAME=<region shown in Supabase>
#   AWS_S3_ADDRESSING_STYLE=path
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=auto
